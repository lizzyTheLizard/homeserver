{
  "name": "homeserver-backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "pnpm build:compile && pnpm build:pack",
    "build:compile": "tsc",
    "build:pack": "jszip-cli add --output homeserver-backend.zip .",
    "dev": "cross-env NODE_ENV=test tsx --watch src/coeditor.ts",
    "lint": "eslint .",
    "clean": "rimraf build homeserver-backend.zip",
    "test": "echo 'No test specified'"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@ffflorian/jszip-cli": "^3.9.1",
    "@scaleway/serverless-functions": "^1.1.2",
    "@stylistic/eslint-plugin": "^5.5.0",
    "@types/node": "^24.10.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "npm-pack-zip": "^1.3.0",
    "rimraf": "^6.1.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3"
  }
}
