#!/usr/bin/env bash
# Block direct pushes to the default branch.
set -euo pipefail

protected=("refs/heads/main" "refs/heads/master")
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ -z "${remote_ref:-}" ]; then
    continue
  fi
  for ref in "${protected[@]}"; do
    if [ "$remote_ref" = "$ref" ]; then
      echo "pre-push: pushing to $remote_ref is blocked." >&2
      echo "Push the change branch and open a pull request instead." >&2
      status=1
    fi
  done
done

exit "$status"
