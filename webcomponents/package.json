{
  "name": "homeserver-webcomponents",
  "type": "module",
  "scripts": {
    "clean": "rimraf build dist",
    "storybook": "storybook dev -p 6006",
    "build": " pnpm build:compile && pnpm build:pack && pnpm build:storybook",
    "build:compile": "tsc",
    "build:pack": "rollup -c",
    "build:storybook": "storybook build -o ./dist/storybook",
    "lint": "pnpm lint:lit-analyzer && pnpm lint:eslint",
    "lint:eslint": "eslint",
    "lint:lit-analyzer": "lit-analyzer",
    "lint:fix": "eslint --fix",
    "test": "vitest",
    "chromatic": "npx chromatic --build-script-name build:storybook"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "4.1.2",
    "@eslint/js": "^9.38.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@storybook/addon-docs": "^10.0.0",
    "@storybook/addon-vitest": "10.0.0",
    "@storybook/web-components-vite": "^10.0.0",
    "@stylistic/eslint-plugin": "^5.5.0",
    "@vitest/browser-playwright": "^4.0.4",
    "@vitest/coverage-v8": "^4.0.4",
    "chromatic": "^13.3.2",
    "eslint": "^9.38.0",
    "globals": "^16.4.0",
    "lit": "^3.3.1",
    "lit-analyzer": "^2.0.3",
    "playwright": "^1.56.1",
    "rimraf": "^6.0.1",
    "rollup": "^4.52.5",
    "rollup-plugin-sass": "^1.15.3",
    "sass": "^1.93.2",
    "shadow-dom-testing-library": "^1.13.1",
    "storybook": "^10.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^4.0.4"
  }
}
