# Infrastructure / Docker Compose
# Copy to .env and fill in real values

# --- Host ---
HOST_IP=127.0.0.1

# --- Database Passwords ---
PROD_DB_PASSWORD=change-me-prod
TEST_DB_PASSWORD=change-me-test

# --- Application (shared, consumed via env_file) ---
NODE_ENV=production
LOG_LEVEL=info
LOG_URL=https://logs.gutschi.site
ADMIN_EMAIL=admin@gutschi.site

# --- Azure AD OIDC ---
CLIENT_ID=your-client-id
LOGIN_ISSUER=https://login.microsoftonline.com/7bd72b43-52f6-4dc6-a856-5704e0f925bd/v2.0
CLIENT_SECRET=your-client-secret

# --- Session ---
COOKIE_NAME=homeserver-session
SESSION_PASSWORD=your-session-password-at-least-32-chars

# --- AI ---
AI_API_KEY=your-ai-api-key
AI_LOG_REQUEST_RESPONSE=false

# --- Microsoft Graph ---
MICROSOFT_GRAPH_APPLICATION_ID=your-graph-app-id
MICROSOFT_GRAPH_CLIENT_SECRET=your-graph-client-secret
MICROSOFT_GRAPH_ISSUER=https://login.microsoftonline.com/7bd72b43-52f6-4dc6-a856-5704e0f925bd/v2.0

# --- Admin Backend ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

