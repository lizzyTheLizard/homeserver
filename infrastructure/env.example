# Infrastructure / Docker Compose
# Copy to .env and fill in real values

# --- Host ---
HOST_IP=127.0.0.1

# --- Database Passwords ---
PROD_DB_PASSWORD=change-me-prod

# --- Application (shared, consumed via env_file) ---
NODE_ENV=production
LOG_LEVEL=info
LOG_URL=https://logs.gutschi.site
ADMIN_EMAIL=admin@gutschi.site

# --- Azure AD OIDC ---
CLIENT_ID=your-client-id
LOGIN_ISSUER=https://login.microsoftonline.com/your-tenant/v2.0
CLIENT_SECRET=client-secret

# --- Session ---
COOKIE_NAME=homeserver-session
SESSION_PASSWORD=your-session-password-at-least-32-chars

# --- AI ---
AI_API_KEY=your-ai-api-key
AI_LOG_REQUEST_RESPONSE=false

# --- Microsoft Graph ---
# App registration used for personal OneDrive backup upload. Register it as
# "Accounts in any organizational directory and personal Microsoft accounts" and
# grant the DELEGATED permissions Files.ReadWrite + offline_access (user consent).
MICROSOFT_GRAPH_APPLICATION_ID=your-graph-app-id
# Optional for public clients; required if the app registration is a web app.
MICROSOFT_GRAPH_CLIENT_SECRET=your-graph-client-secret

# --- Database Backup ---
# Nightly pg_dump of the PROD database (container "Backup"), stored in
# /opt/homeserver/backup on the host (kept 31 days) and uploaded to a PERSONAL
# OneDrive account via a delegated refresh token.
#
# 1. Create the app registration above and add delegated Files.ReadWrite + offline_access.
# 2. Run: docker compose run --rm backup node /usr/local/bin/get-onedrive-token.mjs
#    (or: node infrastructure/db-backup/get-onedrive-token.mjs locally)
# 3. Paste the printed refresh token below.
ONEDRIVE_REFRESH_TOKEN=your-personal-onedrive-refresh-token
# Folder under the OneDrive root where dumps are stored (default: Homeserver).
ONEDRIVE_BACKUP_FOLDER=Homeserver

# --- Backends ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin
DEV_USERNAME=dev
DEV_PASSWORD=cange-me-dev
REPO_URL=git@github.com:name/repo.git
GIT_NAME=name
GIT_MAIL=test@example.com
DEV_SSH_KEY_PUB=

