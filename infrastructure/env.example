# Infrastructure / Docker Compose
# Copy to .env and fill in real values

# --- Host ---
HOST_IP=127.0.0.1

# --- Database Passwords ---
PROD_DB_PASSWORD=change-me-prod
TEST_DB_PASSWORD=change-me-test

# --- Application (shared, consumed via env_file) ---
NODE_ENV=production
LOG_LEVEL=info
LOG_URL=https://logs.gutschi.site
ADMIN_EMAIL=admin@gutschi.site

# --- Azure AD OIDC ---
CLIENT_ID=your-client-id
LOGIN_ISSUER=https://login.microsoftonline.com/your-tenant/v2.0
CLIENT_SECRET=client-secret

# --- Session ---
COOKIE_NAME=homeserver-session
SESSION_PASSWORD=your-session-password-at-least-32-chars

# --- AI ---
AI_API_KEY=your-ai-api-key
AI_LOG_REQUEST_RESPONSE=false

# --- Microsoft Graph ---
MICROSOFT_GRAPH_APPLICATION_ID=your-graph-app-id
MICROSOFT_GRAPH_CLIENT_SECRET=your-graph-client-secret
MICROSOFT_GRAPH_ISSUER=https://login.microsoftonline.com/your-tenant/v2.0

# --- Backends ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin
DEV_USERNAME=dev
DEV_PASSWORD=cange-me-dev
REPO_URL=git@github.com:name/repo.git
GIT_NAME=name
GIT_MAIL=test@example.com
DEV_SSH_KEY_PUB=

