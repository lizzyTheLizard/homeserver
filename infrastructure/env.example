# Infrastructure / Docker Compose
# Copy to .env and fill in real values

# --- Host ---
HOST_IP=127.0.0.1

# --- Database Passwords ---
PROD_DB_PASSWORD=change-me-prod

# --- Wichteln ---
# The Wichteln app shares the production database (wichteln_* tables) and fails
# closed if any of these values is missing.
WICHTELN_SESSION_SECRET=change-me-wichteln-session-at-least-32-chars
WICHTELN_ADMIN_USER=admin
WICHTELN_ADMIN_PASSWORD=change-me-wichteln-admin

# --- Application (shared, consumed via env_file) ---
NODE_ENV=production
LOG_LEVEL=info
LOG_URL=https://logs.gutschi.site
ADMIN_EMAIL=admin@gutschi.site

# --- Azure AD OIDC ---
CLIENT_ID=your-client-id
LOGIN_ISSUER=https://login.microsoftonline.com/your-tenant/v2.0
CLIENT_SECRET=client-secret

# --- Session ---
COOKIE_NAME=homeserver-session
SESSION_PASSWORD=your-session-password-at-least-32-chars

# --- AI ---
AI_API_KEY=your-ai-api-key
AI_LOG_REQUEST_RESPONSE=false

# --- WhatsApp (WAHA) ---
# API key protecting the WAHA containers; also read by the web application (env_file).
WAHA_API_KEY=change-me-waha-api-key

# --- Microsoft Graph ---
# App registration used for personal OneDrive backup upload. Register it as
# "Accounts in any organizational directory and personal Microsoft accounts" and
# grant the DELEGATED permissions Files.ReadWrite + offline_access (user consent).
MICROSOFT_GRAPH_APPLICATION_ID=your-graph-app-id
MICROSOFT_GRAPH_ISSUER=https://login.microsoftonline.com/your-tenant/v2.0
# Optional for public clients; required if the app registration is a web app.
MICROSOFT_GRAPH_CLIENT_SECRET=your-graph-client-secret

# --- Database Backup ---
# Nightly pg_dump of the PROD database (container "Backup"), stored in
# /opt/homeserver/backup on the host (kept 31 days) and uploaded to a PERSONAL
# OneDrive account via a delegated refresh token.
#
# 1. Create the app registration above and add delegated Files.ReadWrite + offline_access.
# 2. Get a refresh token with the device-code flow (see infrastructure/README.md, section 5.6).
# 3. Paste the refresh token below.
ONEDRIVE_REFRESH_TOKEN=your-personal-onedrive-refresh-token
# Folder under the OneDrive root where dumps are stored (default: Homeserver).
ONEDRIVE_BACKUP_FOLDER=Homeserver

# --- Brevo (transactional mail) ---
# Add the domain gutschi.site in Brevo (Senders, domains & dedicated IPs) and copy its
# verification code (the part after "brevo-code:") into BREVO_CODE; bind9 publishes it.
# Compare the DKIM CNAME targets in bind9/db.gutschi.site with the dashboard.
BREVO_CODE=your-brevo-verification-code
# API key (SMTP & API > API keys) and a sender verified in Brevo; used by the backup service.
BREVO_API_KEY=your-brevo-api-key
MAIL_FROM=backup@gutschi.site
# Recipient of the backup mails (default: matthias.graf@gutschi.site).
MAIL_TO=matthias.graf@gutschi.site
# Set to false to only get a mail when a backup fails.
MAIL_ON_SUCCESS=true

# --- Basic Authentication ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin
DEV_USERNAME=dev
DEV_PASSWORD=cange-me-dev


# --- DevMachine ---
REPO_URL=git@github.com:name/repo.git
GIT_NAME=name
GIT_MAIL=test@example.com
DEV_SSH_KEY_PUB=

