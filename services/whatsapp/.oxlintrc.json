{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "style": "error",
    "perf": "warn"
  },
  "env": {
    "node": true
  },
  "ignorePatterns": [
    "dist/**"
  ],
  "rules": {
    "one-var": "off",
    "no-ternary": "off",
    "max-statements": "warn"
  }
}
