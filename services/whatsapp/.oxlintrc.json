{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "style": "error",
    "perf": "warn"
  },
  "env": {
    "node": true
  },
  "ignorePatterns": [
    "dist/**"
  ],
  "rules": {
    "one-var": "off",
    "no-ternary": "off",
    "max-statements": "warn",
    "func-style": [
      "error",
      "declaration"
    ],
    "no-magic-numbers": "warn",
    "max-params": "warn",
    "logical-assignment-operators": [
      "error",
      "never"
    ],
    "typescript/parameter-properties": [
      "error",
      {
        "prefer": "parameter-property"
      }
    ],
    "id-length": "warn"
  },
  "overrides": [
    {
      "files": [
        "**/*.tests.ts",
        "**/*.tests.tsx"
      ],
      "rules": {
        "typescript/no-unsafe-type-assertion": "off"
      }
    }
  ]
}
