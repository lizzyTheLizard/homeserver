    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "async-mutex": "^0.5.0",
    "express": "^5.3.0",
    "winston": "^3.19.0"
