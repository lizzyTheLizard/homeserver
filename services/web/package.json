{
  "name": "@homeserver/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv run -f ../.env -- next dev --hostname 0.0.0.0",
    "build": "next build --turbopack",
    "lint": "oxlint --type-aware --fix -c ../../.oxlintrc.json && oxfmt -c ../../.oxfmtrc.json",
    "lint:ci": "oxlint --type-aware -c ../../.oxlintrc.json && oxfmt --check -c ../../.oxfmtrc.json",
    "test": "vitest --run",
    "test:watch": "vitest --watch",
    "clean": "rimraf .next storybook-static dist next-env.d.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "format": "oxfmt -c ../../.oxfmtrc.json",
    "format:check": "oxfmt --check -c ../../.oxfmtrc.json"
  },
  "dependencies": {
    "@ai-sdk/groq": "^4.0.85",
    "@js-temporal/polyfill": "^0.5.1",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "ai": "^7.0.177",
    "async-mutex": "^0.5.0",
    "iron-session": "^9.0.1",
    "next": "^16.4.6",
    "openid-client": "^6.8.8",
    "papaparse": "^5.7.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-qr-code": "^2.2.0",
    "recharts": "^3.10.1",
    "uuid": "^14.0.3",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-vitest": "^10.6.5",
    "@storybook/nextjs-vite": "^10.6.7",
    "@storybook/react": "^10.6.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser-playwright": "^5.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^18.0.9",
    "jsdom": "^31.0.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "playwright": "^1.65.1",
    "rimraf": "^6.1.3",
    "storybook": "^10.6.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
