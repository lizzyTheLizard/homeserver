{
  "name": "@homeserver/assistant",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv run -f ../.env -- tsx watch server.ts",
    "build": "tsc --project tsconfig.build.json && tsc-alias --project tsconfig.build.json && copyfiles '**/*.md' dist",
    "lint": "oxlint --type-aware --fix -c ../../.oxlintrc.json && oxfmt -c ../../.oxfmtrc.json",
    "lint:ci": "oxlint --type-aware -c ../../.oxlintrc.json && oxfmt --check -c ../../.oxfmtrc.json",
    "test": "vitest --run",
    "test:watch": "vitest --watch",
    "clean": "rimraf dist",
    "format": "oxfmt -c ../../.oxfmtrc.json",
    "format:check": "oxfmt --check -c ../../.oxfmtrc.json"
  },
  "dependencies": {
    "@ai-sdk/groq": "^4.0.85",
    "@js-temporal/polyfill": "^0.5.1",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "ai": "^7.0.177",
    "async-mutex": "^0.5.0",
    "iron-session": "^9.0.1",
    "openid-client": "^6.8.8",
    "pg": "^8.23.1",
    "winston": "^3.19.0",
    "ws": "^8.21.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "copyfiles": "^2.4.1",
    "dotenv": "^18.0.9",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "rimraf": "^6.1.3",
    "tsc-alias": "^1.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
