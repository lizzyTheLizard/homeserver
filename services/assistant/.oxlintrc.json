{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "env": {
    "node": true
  },
  "ignorePatterns": [
    "dist/**"
  ],
  "overrides": [
    {
      "files": [
        "**/*.tests.ts",
        "**/*.tests.tsx"
      ],
      "rules": {
        "typescript/no-unsafe-type-assertion": "off",
        "typescript/consistent-return": "off"
      }
    }
  ]
}
