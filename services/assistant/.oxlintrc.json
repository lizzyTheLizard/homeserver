{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "style": "error",
    "perf": "warn"
  },
  "env": {
    "node": true
  },
  "ignorePatterns": [
    "dist/**"
  ],
  "rules": {
    "one-var": "off",
    "no-ternary": "off",
    "max-statements": "warn",
    "func-style": [
      "error",
      "declaration"
    ],
    "no-magic-numbers": [
      "error",
      {
        "ignore": [
          0,
          1
        ]
      }
    ],
    "max-params": "warn",
    "logical-assignment-operators": [
      "error",
      "never"
    ]
  }
}
