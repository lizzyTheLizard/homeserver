{
  "name": "@homeserver/backup",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv run -f ../.env -- tsx watch src/main.ts",
    "dev:now": "dotenv run -f ../.env -- tsx src/main.ts --now",
    "build": "tsc && esbuild src/main.ts --bundle --platform=node --target=node26 --format=cjs --outfile=dist/main.js",
    "lint": "oxlint --type-aware --fix -c ../../.oxlintrc.json && oxfmt -c ../../.oxfmtrc.json",
    "lint:ci": "oxlint --type-aware -c ../../.oxlintrc.json && oxfmt --check -c ../../.oxfmtrc.json",
    "test": "vitest --run --passWithNoTests",
    "test:watch": "vitest --watch",
    "clean": "rimraf dist",
    "format": "oxfmt -c ../../.oxfmtrc.json",
    "format:check": "oxfmt --check -c ../../.oxfmtrc.json"
  },
  "dependencies": {
    "@microsoft/microsoft-graph-client": "^3.1.0",
    "croner": "^11.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "dotenv": "^18.0.9",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
