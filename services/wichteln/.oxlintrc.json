{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react"
  ],
  "jsPlugins": [
    "eslint-plugin-react-refresh"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "style": "error",
    "perf": "warn"
  },
  "env": {
    "node": true,
    "browser": true
  },
  "ignorePatterns": [
    ".next/**",
    "out/**",
    "build/**",
    "next-env.d.ts"
  ],
  "rules": {
    "react-refresh/only-export-components": [
      "error",
      {
        "allowExportNames": [
          "metadata",
          "viewport",
          "dynamic"
        ]
      }
    ],
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "error",
    "react/purity": "off",
    "react/react-in-jsx-scope": "off"
  }
}
