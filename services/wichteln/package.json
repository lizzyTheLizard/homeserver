{
  "name": "@homeserver/wichteln",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv run -f ../.env -- next dev --hostname 0.0.0.0 --port 3001",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint --type-aware --fix -c ../../.oxlintrc.json && oxfmt -c ../../.oxfmtrc.json",
    "lint:ci": "oxlint --type-aware -c ../../.oxlintrc.json && oxfmt --check -c ../../.oxfmtrc.json",
    "test": "vitest --run",
    "test:watch": "vitest --watch",
    "clean": "rimraf .next next-env.d.ts",
    "format": "oxfmt -c ../../.oxfmtrc.json",
    "format:check": "oxfmt --check -c ../../.oxfmtrc.json"
  },
  "dependencies": {
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
