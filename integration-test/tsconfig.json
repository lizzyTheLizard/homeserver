{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true,
    "isolatedModules": true
  },
  "include": ["src/**/*.ts", "vitest.config.mts", "eslint.config.mjs"],
  "exclude": ["node_modules", "dist", "scripts", "mock-oidc"]
}
