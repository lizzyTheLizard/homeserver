# Fixed, non-secret test values for the smoke-test stack.
# Used via: docker compose --env-file integration-test/env.test
#   and as the container env_file for services that override the repo `.env`.
# Never put real secrets here — the ONLY real secret in the smoke flow is
# AI_API_KEY, which comes from CI (secrets.AI_API_KEY) or the local ../.env.

# --- Host ---
HOST_IP=127.0.0.1

# --- Database ---
PROD_DB_PASSWORD=smoke-test-db-password
POSTGRES_USER=homeserver
POSTGRES_DB=homeserver

# --- Application (also used by the assistant via env_file) ---
NODE_ENV=production
LOG_LEVEL=info
LOG_URL=https://logs.gutschi.site
APP_URL=https://www.gutschi.site
ADMIN_EMAIL=smoke-test@example.com
DB_CONNECTION_STRING=postgres://homeserver:smoke-test-db-password@postgresprod:5432/homeserver?sslmode=disable
ASSISTANT_INTERNAL_URL=http://assistant:8500
WHATSAPP_BRIDGE_URL=http://whatsapp-bridge:8400
COOKIE_NAME=homeserver-session
SESSION_PASSWORD=smoke-test-session-password-which-is-32-plus-chars

# --- OIDC (points at the mock-oidc-server service; openid-client needs HTTPS) ---
CLIENT_ID=smoke-test-client
CLIENT_SECRET=smoke-test-client-secret
LOGIN_ISSUER=https://mock-oidc-server:8080

# --- Basic auth for caddy (dozzle / pgweb / dev-machine UIs) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=smoke-test-admin-password
DEV_USERNAME=dev
DEV_PASSWORD=smoke-test-dev-password

# --- DevMachine (dummy values; SSH 2222 is all the smoke suite uses) ---
REPO_URL=git@github.com:lizzyTheLizard/homeserver.git
GIT_NAME=Smoke Test
GIT_MAIL=smoke-test@example.com
DEV_SSH_KEY_PUB=smoke-test-ssh-key

# --- Microsoft Graph / OneDrive (dummy; not exercised by the smoke suite) ---
MICROSOFT_GRAPH_APPLICATION_ID=smoke-test-graph-application-id
MICROSOFT_GRAPH_CLIENT_SECRET=smoke-test-graph-client-secret
MICROSOFT_GRAPH_ISSUER=https://login.microsoftonline.com/smoke-test-tenant/v2.0
ONEDRIVE_REFRESH_TOKEN=smoke-test-onedrive-refresh-token
ONEDRIVE_BACKUP_FOLDER=Homeserver

# --- Assistant ---
AI_LOG_REQUEST_RESPONSE=false
