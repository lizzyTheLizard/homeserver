{
  "name": "homeserver",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n web,bridge,assistant,wichteln -c blue,green,yellow,magenta \"pnpm dev:app\" \"pnpm dev:bridge\" \"pnpm dev:assistant\" \"pnpm dev:wichteln\"",
    "dev:app": "pnpm --filter @homeserver/web dev",
    "dev:bridge": "pnpm --filter @homeserver/whatsapp dev",
    "dev:assistant": "pnpm --filter @homeserver/assistant dev",
    "dev:wichteln": "pnpm --filter @homeserver/wichteln dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "lint:ci": "pnpm -r lint:ci",
    "test": "pnpm -r test",
    "test:watch": "pnpm -r test:watch",
    "clean": "pnpm -r clean && rimraf node_modules dist",
    "build-storybook": "pnpm --filter @homeserver/web build-storybook"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "rimraf": "^6.1.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.21.0",
      "onFail": "download"
    }
  }
}
