{
  "name": "homeserver",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n web,bridge,assistant -c blue,green,yellow \"pnpm dev:app\" \"pnpm dev:bridge\" \"pnpm dev:assistant\"",
    "dev:app": "pnpm --filter @homeserver/web dev",
    "dev:bridge": "cd whatsapp-bridge && air",
    "dev:assistant": "pnpm --filter @homeserver/assistant dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "lint:ci": "pnpm -r lint:ci",
    "test": "pnpm -r test",
    "test:watch": "pnpm -r test:watch",
    "clean": "pnpm -r clean && rimraf node_modules dist .eslintcache"
 },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "rimraf": "^6.1.3"
  },
  "packageManager": "pnpm@11.7.0+sha512.19cc852c120c7125760f2443ee6be0ca5b40f9f50598de1a09a1f177503e010e57c23c77646e01e761de59bf874fb22a3398c33ab9691fc13eb946b6f0f4d620"
}
