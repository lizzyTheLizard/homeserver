{
  "name": "homeserver",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch server.ts",
    "dev:nowatch": "tsx server.ts",
    "build": "tsc --project tsconfig.build.json && tsc-alias --project tsconfig.build.json && next build",
    "start": "node dist/server.js",
    "lint": "eslint --fix --cache",
    "lint:ci": "eslint",
    "test": "vitest --run",
    "test:watch": "vitest --watch",
    "clean": "rimraf .next storybook-static dist .eslintcache next-env.d.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "npx chromatic --build-script-name build-storybook",
    "restoreBackup": "node --import tsx --env-file-if-exists=.env ./app/shared/_external/db/restoreBackup.ts"
  },
  "dependencies": {
    "@ai-sdk/groq": "^4.0.17",
    "@js-temporal/polyfill": "^0.5.1",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "ai": "^7.0.65",
    "async-mutex": "^0.5.0",
    "dotenv": "^17.4.2",
    "iron-session": "^8.0.4",
    "jimp": "^1.6.1",
    "next": "16.2.12",
    "openid-client": "^6.8.4",
    "papaparse": "^5.5.4",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "react-qr-code": "^2.2.0",
    "uuid": "^14.0.1",
    "winston": "^3.19.0",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@electric-sql/pglite": "^0.5.4",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.5.8",
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/addon-vitest": "^10.5.3",
    "@storybook/nextjs-vite": "^10.5.8",
    "@storybook/react": "^10.5.3",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.21.0",
    "@types/pg-copy-streams": "^1.2.5",
