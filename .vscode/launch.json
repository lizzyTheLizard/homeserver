    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Frontend in Edge",
            "type": "msedge",
            "request": "launch",
            "url": "http://localhost:3000",
            "webRoot": "${workspaceFolder}",
            "resolveSourceMapLocations": [
                "**",
                "!**/node_modules/**",
                "!**/_next/**"
            ]
        },
        {
            "name": "Debug Storybook in Edge",
            "type": "msedge",
            "request": "launch",
            "url": "http://localhost:6006",
            "webRoot": "${workspaceFolder}/webcomponents",
        }

    ]
}