# ==========================================
# Homeserver .env Template
# ==========================================
# This file documents all required environment variables.
# To set up this project in a new Codespace, add each
# secret value as a GitHub Codespaces secret:
#   Repo Settings > Secrets and variables > Codespaces
#
# The post-create.sh script generates the actual .env
# file from Codespaces secrets automatically.
#
# Secrets required:
#   DB_CONNECTION_STRING           - PostgreSQL connection string
#   ADMIN_EMAIL                    - Admin user email
#   AI_API_KEY_OPENCODE            - OpenCode AI API key
#   AI_API_KEY                     - Groq/other AI API key
#   CLIENT_ID                      - Azure AD application client ID
#   CLIENT_SECRET                  - Azure AD application client secret
#   LOGIN_ISSUER                   - Azure AD login issuer URL
#   MICROSOFT_GRAPH_APPLICATION_ID - Microsoft Graph application ID
#   MICROSOFT_GRAPH_ISSUER         - Microsoft Graph issuer URL
#   MICROSOFT_GRAPH_CLIENT_SECRET  - Microsoft Graph client secret
#   CHROMATIC_PROJECT_TOKEN        - Chromatic visual testing token
#   TEST_MICROSOFT_REFRESH_TOKEN   - Test Microsoft refresh token
#   TEST_TO_MAIL_ADDRESS           - Test recipient email
#   OPENCODE_SERVER_PASSWORD       - (optional) Password for OpenCode Web
# ==========================================

# Dev
NODE_ENV=development

# Secrets (set via Codespaces secrets)
# DB_CONNECTION_STRING=
# ADMIN_EMAIL=
# AI_API_KEY_OPENCODE=
# AI_API_KEY=
# CLIENT_ID=
# CLIENT_SECRET=
# LOGIN_ISSUER=
# MICROSOFT_GRAPH_APPLICATION_ID=
# MICROSOFT_GRAPH_ISSUER=
# MICROSOFT_GRAPH_CLIENT_SECRET=
AI_LOG_REQUEST_RESPONSE=false

# Production defaults
APP_URL=http://localhost:3000
AI_BASE_URL=https://opencode.ai/zen/go/v1
COOKIE_NAME=homeserver-session
SESSION_PASSWORD=dev-only-session-password-must-be-32-chars-long
GIT_BRANCH=main
GIT_COMMIT_HASH=12345
GITHUB_RUN_ID=1
BUILD_TIME=2024-06-10T12:00:00Z
GRAFANA_URL=http://localhost:3000/grafana

# Other
# CHROMATIC_PROJECT_TOKEN=
# TEST_MICROSOFT_REFRESH_TOKEN=
# TEST_TO_MAIL_ADDRESS=
# OPENCODE_SERVER_PASSWORD=
